{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx tsx --test tests/unit/*.test.ts"
  },
  "coverageAnalysis": "off",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/game/scoring.ts",
    "src/game/events.ts",
    "src/game/simulation/**/*.ts",
    "src/game/character/needs.ts",
    "src/game/character/schedule.ts",
    "src/game/character/stateMachine.ts",
    "src/game/character/pathfinder.ts",
    "src/lib/**/*.ts"
  ],
  "reporters": ["clear-text", "html"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 30000,
  "concurrency": 2
}
